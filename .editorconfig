root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 110

[*.{hpp,cpp,h,c,cc}]
indent_size = 4

[*.{md,rst}]
trim_trailing_whitespace = false
max_line_length = off

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.py]
indent_size = 4

[*.{vcxproj,vcxproj.filters,vcxproj.user,sln,props,targets}]
end_of_line = crlf
indent_size = 2

[*.{rc,manifest}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 2
