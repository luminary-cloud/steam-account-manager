# Generated protobuf sources (regenerated each build by the GenProtos target)
**/*.pb.cc
**/*.pb.h
core/steam_auth/gen/.timestamp

# Vendored libraries are fetched by scripts/init_third_party.ps1, not committed.
/third_party/*
!/third_party/.gitkeep
!/third_party/README.md
!/third_party/steam_protos/
!/third_party/steam_protos/**
!/third_party/protobuf/
!/third_party/protobuf/bin/
!/third_party/protobuf/bin/protoc.exe
!/third_party/protobuf/include/
!/third_party/protobuf/include/**
!/third_party/protobuf/lib/
!/third_party/protobuf/lib/libprotobuf.lib
!/third_party/protobuf/lib/libprotobuf-lite.lib
!/third_party/protobuf/proto-include/
!/third_party/protobuf/proto-include/**
!/third_party/protobuf/README.md

# Vendored library build artifacts
/third_party/*/build/
/third_party/*/out/
/third_party/*/Debug/
/third_party/*/Release/
/third_party/*/x64/

# App runtime artifacts (never commit these)
/run/
/logs/
vault.bin
settings.json
*.maFile
combos.txt
fixtures.local/

# Test outputs
/tests/output/
*.gcda
*.gcno

# Project-specific
portable.flag
*.bak
*.tmp
*~
