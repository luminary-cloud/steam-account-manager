#include <winres.h>
#include "app/resource.h"
#include "core/version.hpp"

#define SAM_MAKE_VERSION_STR(maj, min, pat) #maj "." #min "." #pat ".0\0"
#define SAM_VERSION_STR(maj, min, pat) SAM_MAKE_VERSION_STR(maj, min, pat)

#define SAM_VERSION_BIN  SAM_VERSION_MAJOR, SAM_VERSION_MINOR, SAM_VERSION_PATCH, 0
#define SAM_VERSION_TEXT SAM_VERSION_STR(SAM_VERSION_MAJOR, SAM_VERSION_MINOR, SAM_VERSION_PATCH)

IDI_APP_ICON ICON "assets/icon.ico"

// Premier rank badges (bracket 0..6).
200 RCDATA "assets/ranks/premier/0.png"
201 RCDATA "assets/ranks/premier/1.png"
202 RCDATA "assets/ranks/premier/2.png"
203 RCDATA "assets/ranks/premier/3.png"
204 RCDATA "assets/ranks/premier/4.png"
205 RCDATA "assets/ranks/premier/5.png"
206 RCDATA "assets/ranks/premier/6.png"

// Wingman rank icons (rank 0..18).
300 RCDATA "assets/ranks/wingman/0.png"
301 RCDATA "assets/ranks/wingman/1.png"
302 RCDATA "assets/ranks/wingman/2.png"
303 RCDATA "assets/ranks/wingman/3.png"
304 RCDATA "assets/ranks/wingman/4.png"
305 RCDATA "assets/ranks/wingman/5.png"
306 RCDATA "assets/ranks/wingman/6.png"
307 RCDATA "assets/ranks/wingman/7.png"
308 RCDATA "assets/ranks/wingman/8.png"
309 RCDATA "assets/ranks/wingman/9.png"
310 RCDATA "assets/ranks/wingman/10.png"
311 RCDATA "assets/ranks/wingman/11.png"
312 RCDATA "assets/ranks/wingman/12.png"
313 RCDATA "assets/ranks/wingman/13.png"
314 RCDATA "assets/ranks/wingman/14.png"
315 RCDATA "assets/ranks/wingman/15.png"
316 RCDATA "assets/ranks/wingman/16.png"
317 RCDATA "assets/ranks/wingman/17.png"
318 RCDATA "assets/ranks/wingman/18.png"

1 VERSIONINFO
    FILEVERSION    SAM_VERSION_BIN
    PRODUCTVERSION SAM_VERSION_BIN
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS  VS_FF_DEBUG
#else
    FILEFLAGS  0x0L
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "luminary-cloud\0"
            VALUE "FileDescription",  "Steam Account Manager\0"
            VALUE "FileVersion",      SAM_VERSION_TEXT
            VALUE "InternalName",     "steam-account-manager\0"
            VALUE "LegalCopyright",   "MIT License\0"
            VALUE "OriginalFilename", "steam-account-manager.exe\0"
            VALUE "ProductName",      "Steam Account Manager\0"
            VALUE "ProductVersion",   SAM_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
